{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Conversion": {
    "WorkDirectory": "",
    "MaxConcurrentConversions": 2,
    "DuckDbThreads": 4,
    "DuckDbMemoryLimit": "4GB",
    "PreserveRowOrder": true,
    "MaxUploadBytes": null
  }
}
