<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- In-process: out-of-process hosting adds a 2-minute request timeout. -->
      <aspNetCore processPath="dotnet" arguments=".\CsvToParquet.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <security>
        <requestFiltering>
          <!-- The IIS maximum (~4 GB). Use Windows Service mode for larger files. -->
          <requestLimits maxAllowedContentLength="4294967295" />
        </requestFiltering>
      </security>
      <!-- Parquet is already compressed. -->
      <urlCompression doStaticCompression="false" doDynamicCompression="false" />
    </system.webServer>
  </location>
</configuration>
